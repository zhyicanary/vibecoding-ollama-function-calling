# ========================================
# AI数字人对话应用 — 配置示例
# 复制此文件为 .env 并填入实际值
# ========================================

# Ollama 服务地址
OLLAMA_HOST=http://localhost:11434

# 默认使用的 Ollama 模型
DEFAULT_MODEL=llama3.2

# LLM 温度参数 (0.0~1.0)
LLM_TEMPERATURE=0.7

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# ========================================
# 邮件发送配置 (SMTP)
# ========================================
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
FROM_EMAIL=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code

# ========================================
# 钉钉通知配置
# ========================================
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# ========================================
# RAG 系统配置
# ========================================
RAG_EMBEDDING_MODEL=qwen3-embedding:4b
RAG_LLM_MODEL=qwen3.5:4b

# 课程文档路径（相对于 backend/ 目录）
COURSE_DOC_PATH=../docs/《智能应用系统设计》课程介绍.md

# Chroma 向量数据库存储路径（相对于 backend/ 目录）
CHROMA_DIR=chroma_db

# ========================================
# Supervisor + Team 多智能体 模型配置
# 不同 Agent 可以使用不同大小的模型
# ========================================
# 路由监督员（需要较好的分类能力）
SUPERVISOR_AGENT_MODEL=qwen3.5:4b

# 天气/时间 Agent（轻量任务，小模型即可）
UTILITY_AGENT_MODEL=qwen3:0.6b

# 邮件/钉钉 Agent
COMM_AGENT_MODEL=qwen3.5:4b

# 股票 Agent
FINANCE_AGENT_MODEL=qwen3.5:4b

# RAG 课程问答 Agent
KNOWLEDGE_AGENT_MODEL=qwen3.5:4b

# 简历筛选评估 Agent
RESUME_AGENT_MODEL=qwen3.5:4b

# 纯对话 Agent
CHAT_AGENT_MODEL=qwen3.5:4b
